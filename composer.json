{
  "name": "HEC TV",
  "type": "Wordpress Plugin",
  "homepage": "https://github.com/ytwguru/hectv-wp",
  "license": "GPLv3",
  "description": "HEC TV plugin for wordpress.",
  "keywords": ["plugin", "hectv"],
  "autoload": {
    "psr-4": {
      "HECTV\\Classes\\": "classes/",
      "HECTV\\Lib\\": "lib/"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "package",
      "package": {
        "name": "ytwguru/wp-api-menus",
        "type": "wordpress-plugin",
        "version": "1.3.2",
        "dist": {
          "type": "zip",
          "url": "https://github.com/ytwguru/wp-api-menus/archive/1.3.2.zip"
        }
      },
      "require" : {
        "composer/installers": "v1.0.12"
      }
    },
    {
      "type": "package",
      "package": {
        "name": "ytwguru/advanced-custom-fields",
        "type": "wordpress-plugin",
        "version": "1.0.0",
        "dist": {
          "type": "zip",
          "url": "https://github.com/ytwguru/advanced-custom-fields/archive/1.0.0.zip"
        }
      },
      "require" : {
        "composer/installers": "v1.0.12"
      }
    }
  ],
  "require": {
    "composer/installers": "~1.0.12",
    "icanboogie/inflector": "^1.4",
    "rmccue/requests": "^1.7",
    "stripe/stripe-php": "^5.8",
    "inpsyde/wonolog": "^1.0",
    "ytwguru/wp-api-menus" : "1.3.2",
    "ytwguru/advanced-custom-fields" : "1.0.0"
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
      "wp-content/themes/{$name}/": ["type:wordpress-theme"]
    }
  }
}
